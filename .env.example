# Poly Monitor — Predexon orderbook history download
# Get a key: https://dashboard.predexon.com
# Docs: https://docs.predexon.com/

# Dual (or more) keys — requests round-robin; each key has its own rate lane.
PREDEXON_API_KEY=
PREDEXON_API_KEY_2=
# Or comma-separated:
# PREDEXON_API_KEYS=pk_...,pk_...

# Pause between Predexon HTTP calls per key×lane (ms).
# Free plan ≈ 1100; Dev/Pro ≈ 10–15.
PREDEXON_REQUEST_DELAY_MS=12

# Sports to download (comma-separated): soccer,football,mlb,tennis,weather
DOWNLOAD_SPORTS=soccer,football,mlb,tennis,weather
# open | closed | both
DOWNLOAD_STATUS=both
DOWNLOAD_DAYS=1
# DOWNLOAD_FROM=2026-09-20
# DOWNLOAD_TO=2026-09-25
# Defaults to max(8, keys×8) when unset — leave blank or set 16 for 2 keys
DOWNLOAD_CONCURRENCY=16
# DOWNLOAD_LIMIT=5

# DATA_DIR=./data
# MONITOR_ROOT=..
