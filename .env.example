# Polymarket orderbook monitor

# How often to refresh the Polymarket catalog for new markets/tokens (ms)
CATALOG_REFRESH_MS=15000

# Minimum gap between event-driven snapshots per token (ms)
BOOK_THROTTLE_MS=500

# Sampler loop tick (ms). Write gaps also depend on book activity below.
BOOK_SAMPLE_MS=2000

# Min gap between writes when top-of-book is in the useful mid range (ms)
BOOK_ACTIVE_MS=1000

# Min gap when book is quiet but not settled (ms)
BOOK_QUIET_MS=10000

# Min gap when book is basically decided (≤2¢ / ≥98¢) (ms)
BOOK_DEAD_MS=120000

# Terminal dashboard refresh (ms)
CONSOLE_REFRESH_MS=1000

# Weather: start recording once any Yes bucket hits this price (0.6 = 60¢)
WEATHER_ARM_PRICE=0.6

# SQLite database path (default: ./data/monitoring.db)
# DB_PATH=./data/monitoring.db

# Live links export path (default: ./data/live-links.json)
# LINKS_PATH=./data/live-links.json

# Web dashboard only: project root if not running from web/
# MONITOR_ROOT=..
